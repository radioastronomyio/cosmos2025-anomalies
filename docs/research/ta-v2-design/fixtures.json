  "mutations": {
    "M1_swap_representation": {
      "description": "Treat the CIGALE linear mass as already logarithmic (swap log/linear metadata)",
      "action": {
        "kind": "set_output_formula",
        "output": "delta_mass_dex",
        "formula": "lephare.mass_med - cigale.mass"
      },
      "intended_reason": "case_mismatch:FX-01a:delta_mass_dex"
    },
    "M2_drop_censoring_state": {
      "description": "Drop the floor_or_censoring_suspected rule from the sfr_100 machine",
      "action": {
        "kind": "drop_state_rule",
        "machine": "sfr_100_point",
        "state": "floor_or_censoring_suspected"
      },
      "intended_reason": "required_state_missing:floor_or_censoring_suspected"
    },
    "M3_allow_heldout_fit": {
      "description": "Remove the fit-request rejection rule from partition_use",
      "action": {
        "kind": "drop_partition_rule",
        "match": "validation or holdout catalog_id is rejected"
      },
      "intended_reason": "fit_request_rule_missing"
    },
    "M4_chi2_quotient": {
      "description": "Reintroduce the chi-square quotient under a new name",
      "action": {
        "kind": "add_output",
        "output": {
          "name": "ctx_fit_quality_ratio",
          "kind": "context_passthrough",
          "formula": "lephare.chi2_best / cigale.chi2_red_best_fit",
          "context_only": true,
          "rankable": false,
          "permitted_predictor": false
        }
      },
      "intended_reason": "chi2_quotient"
    },
    "M5_identity_digest_change": {
      "description": "Change a tracked evidence digest in the identity record (scratch-copy identity mutation)",
      "action": {
        "kind": "change_identity_hash",
        "path": "tracked_evidence_files[0].sha256",
        "value": "deadbeef"
      },
      "intended_reason": "identity_content_mismatch"
    },
    "M6_hidden_shift": {
      "description": "Bake a universal 0.24 dex subtraction into the raw mass delta",
      "action": {
        "kind": "set_output_formula",
        "output": "delta_mass_dex",
        "formula": "lephare.mass_med - log10(cigale.mass) - 0.24"
      },
      "intended_reason": "case_mismatch:FX-01a:delta_mass_dex"
    },
    "M7_reverse_definition": {
      "description": "Reverse the delta sign definition (CIGALE minus LePhare)",
      "action": {
        "kind": "set_output_formula",
        "output": "delta_mass_dex",
        "formula": "log10(cigale.mass) - lephare.mass_med"
      },
      "intended_reason": "case_mismatch:FX-01a:delta_mass_dex"
    },
    "M8_forbidden_covariate": {
      "description": "Admit an individual mass estimate as a centering covariate",
      "action": {
        "kind": "add_center_covariate",
        "center": "mass_center",
        "covariate": "lephare.mass_med"
      },
      "intended_reason": "forbidden_covariate:lephare.mass_med"
    },
    "M9_specz_covariate": {
      "description": "Admit spec-z availability as a centering covariate",
      "action": {
        "kind": "add_center_covariate",
        "center": "mass_center",
        "covariate": "analysis.specz_p2r05_sources.eligibility_primary_galaxy"
      },
      "intended_reason": "forbidden_covariate:analysis.specz_p2r05_sources.eligibility_primary_galaxy"
    },
    "M10_pop_mass_error_clause_removed": {
      "description": "R3 reintroduced: POP-MASS predicate loses the CIGALE mass-error validity conditions",
      "action": {
        "kind": "edit_population_predicate",
        "population": "POP-MASS",
        "predicate": "lephare.type == 0 AND mass_point_state == point_valid"
      },
      "intended_reason": "case_mismatch:FX-R3a:pop_mass"
    },
    "M11_mass_residual_population_gate_removed": {
      "description": "R8 reintroduced: residual_mass_dex loses its declared population gate",
      "action": {
        "kind": "remove_output_field",
        "output": "residual_mass_dex",
        "field": "population_gate"
      },
      "intended_reason": "population_gate_missing:residual_mass_dex"
    },
    "M12_sfr_score_point_state_only": {
      "description": "R2 reintroduced: score_sfr_100 drops the scale-state guard and is gated on point state only",
